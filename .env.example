# Copy to .env — every setting is optional.

# Community ADS-B networks to merge, in priority order
FREEFLIGHT_PROVIDERS=adsb.lol,airplanes.live,adsb.fi

# OpenSky powers the global /v1/flights/world snapshot.
FREEFLIGHT_OPENSKY=true
# Free OpenSky API client (opensky-network.org -> Account -> API client) = 10x more world refreshes
FREEFLIGHT_OPENSKY_CLIENT_ID=
FREEFLIGHT_OPENSKY_CLIENT_SECRET=
# World snapshot refresh in seconds (default: 900 anonymous, 90 with credentials)
FREEFLIGHT_WORLD_TTL=

# How long area results are shared between clients (seconds)
FREEFLIGHT_CACHE_TTL=5
FREEFLIGHT_TIMEOUT=10
# Aircraft photos from planespotters.net
FREEFLIGHT_PHOTOS=true

# Protect a public server: comma-separated keys. Empty = open.
FREEFLIGHT_API_KEYS=
# Requests per minute per key / IP. 0 = unlimited
FREEFLIGHT_RATE_LIMIT=0
FREEFLIGHT_CORS_ORIGINS=*
